{
  "format": "rea-workbench-case-v1",
  "id": "flashlight-apk",
  "order": 6,
  "title": "手电筒为什么要通讯录？",
  "tagline": "一个只需要亮一下的 App",
  "story": "应用商店里有个评分很高的「小光手电筒」，功能就是一个按钮：开灯、关灯。可安装时它弹出一长串权限请求。一个手电筒，到底想要你手机上的什么？装之前，先拆开它的安装包看看清单。",
  "skills": [
    "读懂安卓 App 申请的权限",
    "判断权限和功能是否匹配",
    "发现开机自启和第三方广告组件"
  ],
  "target": "xiaoguang-flashlight.apk",
  "requires": [
    "jadx",
    "java"
  ],
  "questions": [
    {
      "id": "count-permissions",
      "type": "count",
      "section": "申请的权限",
      "prompt": "第一步：这个手电筒一共申请了几项权限？",
      "hint": "在报告里找到「申请的权限」，数一数表格有几行。",
      "explain": "七项。一个只负责开灯关灯的 App，要了七项权限。",
      "gamePrompt": "先数数它一共要了几项权限。在「申请的权限」里，把每一项都点一遍。"
    },
    {
      "id": "unrelated",
      "type": "pick-rows",
      "section": "申请的权限",
      "prompt": "哪几项涉及隐私，却和「照亮」完全没关系？（可以多选）",
      "answer": [
        "读取通讯录",
        "精确定位",
        "读取手机状态和识别码"
      ],
      "hint": "先看「程度」是「敏感」的几项，再排除手电筒真正用得上的那一项：闪光灯长在相机上。",
      "explain": "通讯录、精确定位、手机识别码。相机权限在老手机上确实是开闪光灯需要的，另外三项和照亮毫无关系，却都能用来识别你、追踪你。",
      "gamePrompt": "哪几项涉及隐私，却和照亮一点关系都没有？三项都要找到。"
    },
    {
      "id": "boot",
      "type": "pick-row",
      "section": "App 自己写的组件",
      "prompt": "哪个组件会在手机开机后自动运行，不需要你打开 App？",
      "answer": "BootReceiver",
      "hint": "看「App 自己写的组件」，找名字里有 Boot（开机）的事件接收器。",
      "explain": "BootReceiver。配合「开机后自动启动」的权限，手机一开机它就醒了。旁边还有一个 ContactSyncService，名字直译是「通讯录同步服务」。",
      "gamePrompt": "有个组件会在开机后自己运行，不用打开 App。去「App 自己写的组件」里找。"
    },
    {
      "id": "ads",
      "type": "pick-row",
      "section": "用到的现成能力",
      "prompt": "它还接入了一个第三方服务。是哪个？",
      "answer": "quickads",
      "hint": "看「用到的现成能力」，这些组件不是 App 自己写的。",
      "explain": "com.quickads.sdk，一个广告和追踪服务（组件里有 AdActivity 广告页和 TrackService 追踪服务）。很多免费 App 收集的数据，最后都流向了这类第三方。",
      "distractors": [
        "com.xiaoguang.flashlight",
        "androidx.camera",
        "android.hardware.camera2"
      ],
      "gamePrompt": "它还接入了一个第三方服务。去「用到的现成能力」里找。"
    },
    {
      "id": "what-to-do",
      "type": "choice",
      "section": "申请的权限",
      "prompt": "手机弹出「小光手电筒想读取你的通讯录」时，最好怎么做？",
      "options": [
        "点允许，不然手电筒用不了",
        "点拒绝，手电筒照样能亮",
        "关掉手机，以后不用手电筒"
      ],
      "answer": "点拒绝，手电筒照样能亮",
      "hint": "照亮需要的只有闪光灯。",
      "explain": "点拒绝。现在的安卓和苹果系统都允许你单独拒绝某一项权限，手电筒照样能用。如果拒绝后它就罢工，那它要的根本不是照亮。",
      "gamePrompt": "手机弹出「小光手电筒想读取你的通讯录」时，最好怎么做？"
    }
  ],
  "conclusion": {
    "title": "真相：它要的不只是光",
    "summary": "「小光手电筒」申请了通讯录、精确定位、手机识别码，开机就自动运行，还接入了第三方广告追踪服务。开灯关灯只需要闪光灯，其他的都是在收集你的信息。",
    "realWorld": [
      "2013 年，美国联邦贸易委员会（FTC）调查了一款下载量很大的手电筒 App：它把用户的精确位置和设备识别码交给了包括广告商在内的第三方，最后和 FTC 达成了和解。",
      "后来安卓和苹果都改成了「用到时再单独询问」每一项敏感权限，用户可以只给需要的那一项。",
      "应用商店审核和安全研究员，都会用「权限和功能对不对得上」来初步筛查可疑 App。"
    ],
    "protect": [
      "安装前看一眼它要的权限，和功能对不上的直接拒绝。",
      "手机设置里可以查看并收回每个 App 已有的权限，定期清理一下。",
      "功能简单的工具，优先用手机系统自带的，比如控制中心或通知栏里的手电筒。"
    ],
    "practice": "试试复刻练习：想一想，一个只要闪光灯权限的手电筒应该怎么设计。"
  },
  "note": "这个教学安装包由 scripts/build-case-apk.mjs 生成，只有清单文件，没有代码，也不能安装。",
