  "narrative": {
    "northStar": "像素冒险工作台",
    "overview": "像素地图是视觉主体，羊皮纸面板承载任务与报告，金色菜单突出行动。中文像素字体负责游戏标题与菜单，普通正文负责长报告与配置说明。\n\n四张地图共享同一套操作界面：森林、沙漠、雪山和秋林拥有独立节点坐标，周围营地遵守主题偏好；午夜页眉始终使用浅色文字。",
    "keyCharacteristics": [
      "像素场景与方形菜单",
      "中文像素显示字体和可读正文",
      "地图独立坐标",
      "真实成果与宝箱动效"
    ],
    "rules": [],
    "dos": [
      "Do 使用本地像素资产和中文像素菜单。",
      "Do 用普通正文和等宽代码承载长报告。",
      "Do 为每张地图分别设置节点与角色坐标。",
      "Do 保留键盘焦点与减少动态效果的路径。"
    ],
    "donts": [
      "Don't 在分析进行中自动换图。",
      "Don't 把取消或失败表现为获得成果。",
      "Don't 用远程字体替代已打包字体。"
    ]
  }
